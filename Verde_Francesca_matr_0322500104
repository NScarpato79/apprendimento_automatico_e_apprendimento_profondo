      "source": [
        "#Progetto di Verde Francesca\n",
        "#matr:0322500104\n",
        "#Dataset scelto: Breast Cancer Wisconsin Dataset\n",
        "# Installazione dei pacchetti richiesti direttamente all'interno del notebook\n",
        "import sys\n",
        "\n",
        "!{sys.executable} -m pip install -q numpy pandas matplotlib seaborn scikit-learn tensorflow ucimlrepo\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "import tensorflow as tf\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    confusion_matrix,\n",
        "    f1_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    roc_auc_score,\n",
        "    roc_curve,\n",
        ")\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
        "from sklearn.svm import SVC\n",
        "from tensorflow.keras.layers import BatchNormalization, Dense, Dropout\n",
        "from tensorflow.keras.models import Sequential\n",
        "from ucimlrepo import fetch_ucirepo\n",
        "\n",
        "# Caricamento del dataset  Breast Cancer Wisconsin\n",
        "breast_cancer = fetch_ucirepo(id=17)\n",
        "X = breast_cancer.data.features\n",
        "y = breast_cancer.data.targets.values.ravel()\n",
        "\n",
        "# Gestione dei valori mancanti tramite imputazione con la media\n",
        "X_df = pd.DataFrame(X)\n",
        "if X_df.isnull().sum().sum() > 0:\n",
        "    X_df = X_df.fillna(X_df.mean())\n",
        "\n",
        "# Codifica del target ('B' = Benigno -> 0, 'M' = Maligno -> 1)\n",
        "le = LabelEncoder()\n",
        "y_encoded = le.fit_transform(y)\n",
        "target_names = le.classes_\n",
        "\n",
        "# Standardizzazione delle caratteristiche numeriche\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X_df)\n",
        "\n",
        "# Applicazione della (PCA) per l'analisi spaziale delle feature\n",
        "pca = PCA(n_components=2)\n",
        "X_pca = pca.fit_transform(X_scaled)\n",
        "explained_variance = pca.explained_variance_ratio_\n",
        "\n",
        "# Visualizzazione grafica della distribuzione dei campioni nello spazio PCA\n",
        "plt.figure(figsize=(9, 6))\n",
        "sns.scatterplot(\n",
        "    x=X_pca[:, 0],\n",
        "    y=X_pca[:, 1],\n",
        "    hue=y,\n",
        "    palette={\"B\": \"#2ecc71\", \"M\": \"#e74c3c\"},\n",
        "    alpha=0.7,\n",
        "    edgecolor=\"k\",\n",
        ")\n",
        "plt.title(\n",
        "    \"Analisi delle Componenti Principali (PCA) - Breast Cancer Dataset\"\n",
        ")\n",
        "plt.xlabel(\n",
        "    f\"Componente Principale 1 ({explained_variance[0]:.2%} var.)\"\n",
        ")\n",
        "plt.ylabel(\n",
        "    f\"Componente Principale 2 ({explained_variance[1]:.2%} var.)\"\n",
        ")\n",
        "plt.legend(title=\"Diagnosi\", labels=[\"Benigno (B)\", \"Maligno (M)\"])\n",
        "plt.grid(True, linestyle=\"--\", alpha=0.5)\n",
        "plt.show()\n",
        "\n",
        "# Suddivisione rigida e stratificata dei dati in Training (70%), Validation (15%) e Test (15%)\n",
        "X_train_val, X_test, y_train_val, y_test = train_test_split(\n",
        "    X_scaled, y_encoded, test_size=0.15, random_state=42, stratify=y_encoded\n",
        ")\n",
        "X_train, X_val, y_train, y_val = train_test_split(\n",
        "    X_train_val,\n",
        "    y_train_val,\n",
        "    test_size=0.1765,\n",
        "    random_state=42,\n",
        "    stratify=y_train_val,\n",
        ")\n",
        "\n",
        "# Inizializzazione dei tre modelli di classificazione shallow\n",
        "models = {\n",
        "    \"Logistic Regression\": LogisticRegression(random_state=42),\n",
        "    \"Random Forest\": RandomForestClassifier(\n",
        "        n_estimators=100, random_state=42\n",
        "    ),\n",
        "    \"Support Vector Machine\": SVC(probability=True, random_state=42),\n",
        "}\n",
        "\n",
        "results = {}\n",
        "\n",
        "# Addestramento dei modelli classici ed estrazione delle relative metriche sul test set\n",
        "for name, model in models.items():\n",
        "    model.fit(X_train, y_train)\n",
        "    y_pred = model.predict(X_test)\n",
        "    y_prob = model.predict_proba(X_test)[:, 1]\n",
        "    metrics = {\n",
        "        \"Accuracy\": accuracy_score(y_test, y_pred),\n",
        "        \"Precision\": precision_score(y_test, y_pred, zero_division=0),\n",
        "        \"Recall\": recall_score(y_test, y_pred),\n",
        "        \"F-Measure\": f1_score(y_test, y_pred),\n",
        "        \"ROC AUC\": roc_auc_score(y_test, y_prob),\n",
        "        \"Predictions\": y_pred,\n",
        "        \"Probabilities\": y_prob,\n",
        "    }\n",
        "    results[name] = metrics\n",
        "\n",
        "# Generazione dei grafici combinati delle matrici di confusione e delle curve ROC per i modelli shallow\n",
        "fig, axes = plt.subplots(3, 2, figsize=(14, 18))\n",
        "axes = axes.ravel()\n",
        "idx = 0\n",
        "\n",
        "for name, metrics in results.items():\n",
        "    cm = confusion_matrix(y_test, metrics[\"Predictions\"])\n",
        "    sns.heatmap(\n",
        "        cm,\n",
        "        annot=True,\n",
        "        fmt=\"d\",\n",
        "        cmap=\"Blues\",\n",
        "        xticklabels=[\"Benigno\", \"Maligno\"],\n",
        "        yticklabels=[\"Benigno\", \"Maligno\"],\n",
        "        ax=axes[idx],\n",
        "    )\n",
        "    axes[idx].set_title(f\"Confusion Matrix - {name}\")\n",
        "    axes[idx].set_xlabel(\"Predetto\")\n",
        "    axes[idx].set_ylabel(\"Reale\")\n",
        "    idx += 1\n",
        "\n",
        "    fpr, tpr, _ = roc_curve(y_test, metrics[\"Probabilities\"])\n",
        "    axes[idx].plot(\n",
        "        fpr,\n",
        "        tpr,\n",
        "        color=\"darkorange\",\n",
        "        lw=2,\n",
        "        label=f\"ROC curve (AUC = {metrics['ROC AUC']:.4f})\",\n",
        "    )\n",
        "    # Correzione dell'errore di sintassi: inseriti gli argomenti, [0, 1] per la retta di riferimento\n",
        "    axes[idx].plot([0, 1], [0, 1], color=\"navy\", lw=2, linestyle=\"--\")\n",
        "    axes[idx].set_xlim([0.0, 1.0])\n",
        "    axes[idx].set_ylim([0.0, 1.05])\n",
        "    axes[idx].set_title(f\"ROC Curve - {name}\")\n",
        "    axes[idx].set_xlabel(\"False Positive Rate\")\n",
        "    axes[idx].set_ylabel(\"True Positive Rate\")\n",
        "    axes[idx].legend(loc=\"lower right\")\n",
        "    idx += 1\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Sviluppo della rete neurale artificiale Multi-Layer Perceptron per il Deep Learning\n",
        "model_dl = Sequential(\n",
        "    [\n",
        "        Dense(\n",
        "            32,\n",
        "            activation=\"relu\",\n",
        "            input_shape=(X_train.shape[1],),\n",
        "            name=\"Input_Layer\",\n",
        "        ),\n",
        "        BatchNormalization(),\n",
        "        Dropout(0.3),\n",
        "        Dense(16, activation=\"relu\", name=\"Hidden_Layer\"),\n",
        "        Dropout(0.2),\n",
        "        Dense(1, activation=\"sigmoid\", name=\"Output_Layer\"),\n",
        "    ]\n",
        ")\n",
        "\n",
        "model_dl.compile(\n",
        "    optimizer=\"adam\", loss=\"binary_crossentropy\", metrics=[\"accuracy\"]\n",
        ")\n",
        "\n",
        "# Addestramento monitorato della rete neurale utilizzando l'esatto Validation Set isolato\n",
        "history = model_dl.fit(\n",
        "    X_train,\n",
        "    y_train,\n",
        "    validation_data=(X_val, y_val),\n",
        "    epochs=80,\n",
        "    batch_size=16,\n",
        "    verbose=0,\n",
        ")\n",
        "\n",
        "# Valutazione predittiva del modello di Deep Learning sul Test Set\n",
        "y_prob_dl = model_dl.predict(X_test, verbose=0).ravel()\n",
        "y_pred_dl = (y_prob_dl >= 0.5).astype(int)\n",
        "\n",
        "dl_metrics = {\n",
        "    \"Accuracy\": accuracy_score(y_test, y_pred_dl),\n",
        "    \"Precision\": precision_score(y_test, y_pred_dl, zero_division=0),\n",
        "    \"Recall\": recall_score(y_test, y_pred_dl),\n",
        "    \"F-Measure\": f1_score(y_test, y_pred_dl),\n",
        "    \"ROC AUC\": roc_auc_score(y_test, y_prob_dl),\n",
        "}\n",
        "\n",
        "# Rappresentazione visiva delle curve di apprendimento della rete neurale\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))\n",
        "ax1.plot(history.history[\"loss\"], label=\"Train Loss\")\n",
        "ax1.plot(history.history[\"val_loss\"], label=\"Val Loss\")\n",
        "ax1.set_title(\"Andamento della Loss function\")\n",
        "ax1.set_xlabel(\"Epoche\")\n",
        "ax1.set_ylabel(\"Loss\")\n",
        "ax1.legend()\n",
        "\n",
        "ax2.plot(history.history[\"accuracy\"], label=\"Train Accuracy\")\n",
        "ax2.plot(history.history[\"val_accuracy\"], label=\"Val Accuracy\")\n",
        "ax2.set_title(\"Andamento dell'Accuracy\")\n",
        "ax2.set_xlabel(\"Epoche\")\n",
        "ax2.set_ylabel(\"Accuracy\")\n",
        "ax2.legend()\n",
        "plt.show()\n",
        "\n",
        "# Visualizzazione dei grafici finali di valutazione relativi al Deep Learning\n",
        "fig, (ax_cm, ax_roc) = plt.subplots(1, 2, figsize=(14, 6))\n",
        "cm_dl = confusion_matrix(y_test, y_pred_dl)\n",
        "sns.heatmap(\n",
        "    cm_dl,\n",
        "    annot=True,\n",
        "    fmt=\"d\",\n",
        "    cmap=\"Purples\",\n",
        "    xticklabels=[\"Benigno\", \"Maligno\"],\n",
        "    yticklabels=[\"Benigno\", \"Maligno\"],\n",
        "    ax=ax_cm,\n",
        ")\n",
        "ax_cm.set_title(\"Confusion Matrix - Deep Learning\")\n",
        "ax_cm.set_xlabel(\"Predetto\")\n",
        "ax_cm.set_ylabel(\"Reale\")\n",
        "\n",
        "fpr_dl, tpr_dl, _ = roc_curve(y_test, y_prob_dl)\n",
        "ax_roc.plot(\n",
        "    fpr_dl,\n",
        "    tpr_dl,\n",
        "    color=\"purple\",\n",
        "    lw=2,\n",
        "    label=f\"ROC curve (AUC = {dl_metrics['ROC AUC']:.4f})\",\n",
        ")\n",
        "# Correzione dell'errore di sintassi: inseriti gli argomenti, [0, 1] per la retta di riferimento\n",
        "ax_roc.plot([0, 1], [0, 1], color=\"navy\", lw=2, linestyle=\"--\")\n",
        "ax_roc.set_title(\"ROC Curve - Deep Learning\")\n",
        "ax_roc.set_xlabel(\"False Positive Rate\")\n",
        "ax_roc.set_ylabel(\"True Positive Rate\")\n",
        "ax_roc.legend(loc=\"lower right\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
